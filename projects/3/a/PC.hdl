// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    ////まず inc するかどうか
    Inc16(
        in=pcOut, out=pcPlusOne
    );
    Mux16(
        a=pcOut, b=pcPlusOne, sel=inc, out=afterInc
    );

    ////次に load するかどうか
    Mux16(
        a=afterInc, b=in, sel=load, out=afterLoad
    );

    ////最後に reset するかどうか
    Mux16(
        a=afterLoad, b=false, sel=reset, out=nextPC
    );

    ////最後にレジスタに保存
    Register(
        in=nextPC, load=true, out=pcOut
    );

    And16(a=pcOut, b=true, out=out);
}
